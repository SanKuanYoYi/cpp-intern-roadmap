{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: g++ 调试活动文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "让 gdb 在程序结束后自动退出",
                    "text": "-gdb-set confirm off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ 生成活动文件"
        }
    ]
}